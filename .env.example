# Copy this file to `.env` and adjust as needed.
#
# ── PRIMARY: Neo4j public demo server (read-only, zero setup) ──────────────
# A public server hosted by Neo4j Labs, pre-filled with a real movie graph.
# Username and password are the same as the database name.
NEO4J_URI=neo4j+s://demo.neo4jlabs.com
NEO4J_USERNAME=recommendations
NEO4J_PASSWORD=recommendations
NEO4J_DATABASE=recommendations

# Force read-only mode without attempting a write probe (optional).
# The demo server is read-only anyway; this just skips the probe.
NEO4J_READONLY=true

# ── UPGRADE PATH: Neo4j AuraDB Free (writeable) ────────────────────────────
# When you provision a free AuraDB instance (see docs/auradb-upgrade.md),
# comment out the block above and fill these in from the Aura console:
#
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=<generated-password>
# NEO4J_DATABASE=neo4j
# NEO4J_READONLY=false
